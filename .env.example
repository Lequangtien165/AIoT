# Copy this file to .env on each machine. Do not commit .env.
# Use the LAN IP/hostname of the cloud laptop that runs Mosquitto.
AIOT_BROKER_HOST=192.168.1.20
AIOT_BROKER_PORT=8883

# Edge RTSP publisher address, used by the cloud recognition client.
AIOT_EDGE_IP=192.168.1.30
AIOT_EDGE_DEVICE=Integrated Camera
AIOT_EDGE_MOTION_DEVICE=0

# Path is machine-local: cloud uses config/mosquitto/certs/ca.crt;
# edge uses the copied CA certificate, for example certs/ca.crt.
AIOT_MQTT_CA_CERT=config/mosquitto/certs/ca.crt

# Set the role-specific password for each process. Replace demo values before a real LAN demo.
AIOT_EDGE_MQTT_PASSWORD=replace-with-edge-password
AIOT_RECOGNITION_MQTT_PASSWORD=replace-with-recognition-password
AIOT_LOGGER_MQTT_PASSWORD=replace-with-logger-password
AIOT_CONTROLLER_MQTT_PASSWORD=replace-with-controller-password
